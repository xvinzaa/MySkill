# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local: mongodb://localhost:27017/my-skill
# Atlas: mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/my-skill?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/my-skill

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS - update this for production)
FRONTEND_URL=http://localhost:5173
